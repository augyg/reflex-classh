-- | Use grid to provide a lot of \'padding\'. This element is meant for fast prototyping only. There
-- | are also much better variants
xPaddedRegion :: DomBuilder t m => m a -> m a
xPaddedRegion ma = gridCol Col12 $ divClass $(classh' [colStart .~~ 2, colSpan .~~ 10]) $ ma

  
